{
  "name": "karachi-runner",
  "version": "2.2.28",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "npm run build && cap sync android",
    "build:android:aab": "npm run build:android && cd android && ./gradlew :app:bundleRelease",
    "preview": "vite preview",
    "test": "npm run test:analytics && npm run test:ops && node scripts/test_runner.js",
    "test:analytics": "node --test scripts/test_analytics_command_center.mjs",
    "test:ops": "node --test scripts/test_game_ops_engine.mjs",
    "test:5173": "node scripts/test_runner.js --port=5173",
    "release:check": "npm test && npm run build",
    "release:check:ci": "npm run test:analytics && npm run test:ops && node scripts/test_runner.js --only=TC-01,TC-02,TC-10,TC-26,TC-27,TC-28 && npm run build",
    "build:apk": "node scripts/sign_apk.mjs",
    "deploy:web": "node scripts/deploy_pages.mjs",
    "publish:play": "node scripts/publish_play_console.mjs",
    "release:play": "node scripts/release_next.mjs",
    "release:next": "node scripts/release_next.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "android-package-signer": "^0.2.1",
    "apk_sign_ts": "^1.0.1",
    "googleapis": "^178.0.0",
    "vite": "^5.4.10",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@vitejs/plugin-react": "^4.7.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  }
}
