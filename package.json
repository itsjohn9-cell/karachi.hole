{
  "name": "hole-io-android",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "npm run build && cap copy android",
    "build:android:aab": "npm run build:android && cd android && ./gradlew :app:bundleRelease",
    "preview": "vite preview",
    "test": "npm run test:ops && node scripts/test_runner.js",
    "test:ops": "node --test scripts/test_game_ops_engine.mjs",
    "test:5173": "node scripts/test_runner.js --port=5173",
    "release:check": "npm test && npm run build",
    "release:check:ci": "npm run test:ops && node scripts/test_runner.js --only=TC-01,TC-02,TC-10,TC-18,TC-22,TC-26,TC-27,TC-28 && npm run build",
    "build:apk": "node scripts/sign_apk.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "android-package-signer": "^0.2.1",
    "apk_sign_ts": "^1.0.1",
    "vite": "^5.4.10",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "three": "^0.186.1"
  }
}
